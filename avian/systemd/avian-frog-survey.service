[Unit]
Description=AvianVisitors native frog survey collector
After=birdnet_recording.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/BirdNET-Pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -n /var/lib/avian-frog/service.lock /usr/bin/python3 /home/pi/BirdNET-Pi/avian/scripts/frog_survey_worker.py
TimeoutStartSec=3min
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ReadWritePaths=/var/lib/avian-frog
